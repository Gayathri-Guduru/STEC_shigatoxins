def parse_arguments():
    """
    Parse command line arguments for pipeline configuration.
    
    Returns:
        Parsed arguments namespace
    """
    parser = argparse.ArgumentParser(
        description='EMM Typing Pipeline - Multi-mode bacterial strain typing from NGS data'
    )
    
    # Mode selection (mutually exclusive)
    mode_group = parser.add_mutually_exclusive_group(required=True)
    mode_group.add_argument('--only-wastewater', action='store_true',
                           help='Process wastewater samples without coverage identifiers')
    mode_group.add_argument('--only-wastewater-downsampled', action='store_true',
                           help='Process wastewater samples with coverage identifiers')
    mode_group.add_argument('--metagenomics', action='store_true',
                           help='Process mixed samples (2+ isolates + wastewater)')
    mode_group.add_argument('--mixed_isolates', action='store_true',
                           help='Process mixed isolates (2+ isolates, no wastewater)')
    mode_group.add_argument('--isolates', action='store_true',
                           help='Process single isolates (no coverage in filename)')
    mode_group.add_argument('--isolates-downsampled', action='store_true',
                           help='Process single isolates with coverage identifiers')
    
    # Alignment parameters
    parser.add_argument('--f-values', type=str, default='50',
                       help='Comma-separated minimap2 -f values (default: 50)')
    parser.add_argument('--N-values', type=str, default='30',
                       help='Comma-separated minimap2 -N values (default: 30)')
    
    # Processing parameters
    parser.add_argument('--processes', type=int, default=8,
                       help='Number of parallel processes (default: 8)')
    parser.add_argument('--cpus-per-task', type=int, default=38,
                       help='CPUs per alignment task (default: 38)')
    parser.add_argument('--min-reads', type=int, default=10,
                       help='Minimum reads threshold for filtering (default: 10)')
    parser.add_argument('--max-workers', type=int, default=None,
                       help='Maximum parallel workers (default: auto-detect)')
    
    # Input/output paths
    parser.add_argument('--base-dir', type=str, default=DEFAULT_BASE_DIR,
                       help='Base directory for reference files')
    parser.add_argument('--fastq-dir', type=str, default=DEFAULT_FASTQ_DIR,
                       help='Directory containing FASTQ files')
    parser.add_argument('--output-dir', type=str, required=True,
                       help='Output directory for results')
    
    return parser.parse_args()


